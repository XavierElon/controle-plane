API quickstart (curl)

# Set base
BASE=http://127.0.0.1:8090

# Register a node
NODE_ID=$(curl -s -X POST "$BASE/v1/nodes/register" -H 'content-type: application/json' -d '{"hostname":"agent-1","labels":[["region","us-east-1"],["role","worker"]]}' | jq -r '.id')

# Heartbeat
curl -i -X POST "$BASE/v1/nodes/$NODE_ID/heartbeat"

# Submit a job
JOB_ID=$(curl -s -X POST "$BASE/v1/jobs" -H 'content-type: application/json' -d '{"name":"echo-hello","replicas":2,"command":["echo","hello from starling"],"constraints":[["region","us-east-1"]],"priority":5}' | jq -r '.id')

# Agent pulls next assignment
ASSIGN=$(curl -s "$BASE/v1/agents/$NODE_ID/next"); echo "$ASSIGN" | jq; TASK_ID=$(echo "$ASSIGN" | jq -r '.task_id')

# Update task to Assigned
curl -i -X POST "$BASE/v1/tasks/status" -H 'content-type: application/json' -d "{\"task_id\":\"$TASK_ID\",\"state\":{\"Assigned\":{\"node_id\":\"$NODE_ID\"}}}"
